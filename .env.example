# Copy this file to .env in the same folder (.env is ignored by git, so your key stays on your machine).
# The only thing you must set is a language model for the simulated Alexa. Pick ONE of the four options below.

# Option 1: DeepSeek (the default). Get a key at https://platform.deepseek.com and paste it after the = sign.
AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=disabled

# Option 2: Anthropic (Claude). Set AGENT_PROVIDER=anthropic above, uncomment ANTHROPIC_API_KEY and paste a key from
# https://platform.claude.com after the = sign.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Option 3: Amazon Bedrock. Set AGENT_PROVIDER=bedrock above and uncomment the lines you need.
# Credentials come from the standard AWS chain: either the two keys below, or a profile from `aws configure`.
# The model must be enabled for your account in the Bedrock console, in this region.
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# Option 4: any service with an OpenAI-compatible chat completions API that supports tool calls.
# Set AGENT_PROVIDER=openai above and fill in all three.
# OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=

# Everything below is optional; the defaults work.

# Server and simulator
# GROUPFLOW_PORT=8787
# SIMULATOR_PORT=8788
# GROUPFLOW_DB=data/groupflow.db
# GROUPFLOW_ADMIN_KEY=            # demo console key; `python -m groupflow demo` and `sandbox` make a random one per run
# GROUPFLOW_TIMEZONE=America/Toronto

# Group chat (http://localhost:8788/chat)
# GROUPFLOW_SIGNUP=open            # open, invite (sign-up needs an invite code) or off
# GROUPFLOW_JOIN_URL=http://localhost:8788/chat
# GROUPFLOW_CHAT_DB=data/groupflow.chat.db

# MCP responses: json (one JSON body per request) or sse (streamed). sse lets ask_followup ask the person
# through a host that supports MCP elicitation, as Alexa+ does.
# GROUPFLOW_MCP_RESPONSES=json

# Automatic check-ins on plans that went quiet while something waits: rules (default), model (a language model reviews
# and words each round, using the model settings above; the server still checks every recipient and word) or off.
# GROUPFLOW_CHECKINS=rules
