# Copy to .env (never commit .env). Every value has a working default except the LLM key.

# Alexa's brain in the simulator: deepseek (default), bedrock or openai
AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=disabled

# Amazon Bedrock (AGENT_PROVIDER=bedrock): credentials from the standard AWS chain
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# AGENT_PROVIDER=relay: an outside agent answers each model request over /api/relay (scripts/relay_model.py);
# RELAY_LABEL and RELAY_MODEL name it in transcripts
# Any OpenAI-compatible endpoint (AGENT_PROVIDER=openai)
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=

# Server and simulator
# GROUPFLOW_PORT=8787
# SIMULATOR_PORT=8788
# GROUPFLOW_DB=data/groupflow.db
# GROUPFLOW_ADMIN_KEY=            # demo console key; `python -m groupflow demo` makes a random one per run
# GROUPFLOW_TIMEZONE=America/Toronto

# Group chat (http://localhost:8788/chat)
# GROUPFLOW_SIGNUP=open            # open, invite (sign-up needs an invite code) or off
# GROUPFLOW_JOIN_URL=http://localhost:8788/chat
# GROUPFLOW_CHAT_DB=data/groupflow.chat.db

# MCP responses: json (one JSON body per request) or sse (streamed). sse lets ask_followup ask the person
# through a host that supports MCP elicitation, as Alexa+ does.
# GROUPFLOW_MCP_RESPONSES=json

# Automatic check-ins on plans that went quiet while something waits: rules (default), model (a language model reviews
# and words each round, using the AGENT_PROVIDER settings above; the server still checks every recipient and word) or off.
# GROUPFLOW_CHECKINS=rules
