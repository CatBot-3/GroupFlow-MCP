+    assert gf.commit_project("priya", pid)["outcome"] == "blocked"
+
+
+def test_decline_or_revoke_cannot_be_hidden_by_older_approval(gf):
+    pid = project(gf)
+    work(gf, pid)
+    sent(gf, pid)
