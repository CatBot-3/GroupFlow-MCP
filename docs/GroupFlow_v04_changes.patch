+def test_commitment_carry_is_scoped_and_authorization_binds_whole_stage(gf):
+    pid = project(gf)
+    a = work(gf, pid, owner="marcus")
+    b = work(gf, pid, "Design", owner="sofia")
+    sent(gf, pid)
